#include<iostream>
using namespace std;
template<class t>
class demo
{
    private:
    t num1,num2;
    public:
    demo(t x,t y)
    {
       num1=x;
       num2=y;
    }
    void disp()
    {
        if(num1<num2)
        {
            cout<<num1<<" Less than "<<num2;
        }
        else
        {
            cout<<num1<<"  Greater than  "<<num2;
        }
    }
};
int main()
{
    demo<float>obj(10.1,10.2);
    obj.disp();
}
