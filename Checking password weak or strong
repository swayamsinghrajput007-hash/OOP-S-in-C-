#include<iostream>
using namespace std;
int main()
{
    string pwd;
    bool upper=false;
    bool lower=false;
    bool digit=false;
    cout<<"Enter password of miminum 8 characters: ";
    cin>>pwd;
    if(pwd.length()<=8)
    {
       cout<<"Password not more than 8 letters...Try again";
        return 0;
    }
    for(char ch:pwd)
        {
            if(isupper(ch))
            {
                upper=true;
            }
            if(islower(ch))
            {
                lower=true;
            }
            if(isdigit(ch))
            {
                digit=true;
            }
        }
    if(upper==true&&lower==true&&digit==true)
    {
        cout<<"Password is strong";
    }
    else
    {
        cout<<"Password weak";
    }
    
}
