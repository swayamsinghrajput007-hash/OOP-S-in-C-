#include<iostream>
using namespace std;
class a
{
    int i=1,n;
    public:
    void input()
    {
        cout<<"Enter number for multiplication table: ";
        cin>>n;
    }
    void disp()
    {
        for(i=1;i<=10;i++)
        {
            cout<<n<<"*"<<i<<"="<<n*i<<endl;
        }
    }
};
int main()
{
    a obj;
    obj.input();
    obj.disp();
}
