#include<iostream>
using namespace std;
class a
{
    int i,j;
    public:
    void pattern()
    {
        for(i=1;i<=5;i++)
        {
            cout<<"\n";
            for(j=1;j<=i;j++)
            {
                cout<<j;
            }
        }
    }
};
int main()
{
    a obj;
    obj.pattern();
}
